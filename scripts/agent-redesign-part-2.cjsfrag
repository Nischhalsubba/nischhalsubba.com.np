}

const allProjects = [...featured,
 ['05','/project-masteriyo','Masteriyo',['EdTech','Product design'],'Learning-product interface work.',images.masteriyo],
 ['06','/project-orkest','Orkest',['Product','Interface'],'Product interface exploration and system design.',images.orkest],
 ['07','/project-splashnode','Splashnode',['Web3','Product'],'Product experience and interface work.',images.splashnode],
