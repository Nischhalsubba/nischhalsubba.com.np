];
const projectsMain = () => main(`${hero('Project index','Work that shows the decisions.','A mix of product UX, interfaces, websites, systems, and design-to-development work. The strongest pieces explain what had to become clearer first.')}<section class="agent-section agent-section--compact"><div class="agent-frame"><div class="agent-project-list">${allProjects.map(row).join('')}</div></div></section>`);
const aboutMain = () => main(`${hero('About','Designer close enough to code to know where the bodies are buried.','I’m Nischhal Raj Subba, a product designer in Kathmandu working across product UX, interface design, systems, websites, and implementation handoff.')}<section class="agent-section"><div class="agent-frame agent-about-grid"><div class="agent-about-copy agent-rich-copy" data-agent-reveal><p>I have spent 6+ years across product teams, agencies, Web3, fintech, SaaS, WordPress products, service businesses, and front-end collaboration. The recurring problem is the same: products become difficult when internal complexity leaks into the interface.</p><p>My work is usually about deciding what deserves to be visible, what needs stronger hierarchy, which states are missing, where users can lose confidence, and how the design behaves when the happy path stops being happy.</p><p>I like Figma, but I do not treat the file as the finish line. Responsive behavior, accessibility, motion, component logic, UI QA, and implementation details all affect whether the product still feels designed after handoff.</p><p>I value direct collaboration. I would rather expose an unclear assumption early than decorate it for another week.</p></div><aside class="agent-about-aside" data-agent-reveal><span class="agent-kicker">Useful context</span><div class="agent-proof-stats agent-proof-stats--stacked"><div class="agent-stat"><strong>6+</strong><span>Years</span></div><div class="agent-stat"><strong>UX ↔ UI</strong><span>Flows, interface, systems, handoff</span></div><div class="agent-stat"><strong>KTM</strong><span>Nepal · remote-friendly</span></div></div></aside></div></section><section class="agent-section agent-section--inverse"><div class="agent-frame agent-manifesto"><blockquote data-agent-reveal>“I’m not interested in making complexity look expensive. I’m interested in making it usable.”</blockquote><aside data-agent-reveal><a class="agent-btn" href="/projects">See selected work</a></aside></div></section>`);
const services = [['01','Product UX','Untangle flows, roles, permissions, states, and decision points before visual polish hides the structural problem.'],['02','Interface design','High-fidelity responsive UI with deliberate hierarchy, useful density, complete states, and product-specific character.'],['03','Design systems','Tokens, components, patterns, documentation, and state coverage that create consistency without making the product a component-library demo.'],['04','Website UX','Product and service websites that explain complicated offers quickly, establish trust, and give visitors an obvious next move.'],['05','UX audit','A structured review of information architecture, friction, hierarchy, accessibility, responsive behavior, interaction patterns, and implementation gaps.'],['06','Design-to-dev','Implementation-aware specs, responsive decisions, front-end collaboration, UI QA, and selective coding where it reduces handoff ambiguity.']];
const servicesMain = () => main(`${hero('Services','Useful when the product has too many moving parts.','A focused audit, one difficult flow, a full interface system, a product website, or ongoing design support. Scope follows the problem rather than a fixed package.')}<section class="agent-section"><div class="agent-frame agent-service-grid">${services.map(([n,h,p]) => `<article class="agent-service" data-agent-reveal><span class="agent-meta">${n}</span><div><h2>${h}</h2><p>${p}</p></div></article>`).join('')}</div></section><section class="agent-section agent-section--compact"><div class="agent-frame agent-contact-strip"><h2 data-agent-reveal>Have a messy brief?</h2><div class="agent-actions" data-agent-reveal><a class="agent-btn agent-btn--primary" href="/contact">Send the context</a></div></div></section>`);
const addFormClass = (form) => !form ? '' : /\bclass=["']/.test(form) ? form.replace(/class=(["'])([^"']*)\1/i, (m,q,c) => `class=${q}${c} agent-contact-form${q}`) : form.replace(/<form\b/i, '<form class="agent-contact-form"');
const contactMain = (html) => {
  const existing = html.match(/<form\b[\s\S]*?<\/form>/i)?.[0] || '';
  const form = addFormClass(existing) || `<form class="agent-contact-form" action="mailto:hinischalsubba@gmail.com" method="post" enctype="text/plain"><label>Name<input type="text" name="name" autocomplete="name" required></label><label>Email<input type="email" name="email" autocomplete="email" required></label><label>What are you working on?<textarea name="message" required></textarea></label><button class="agent-btn agent-btn--primary" type="submit">Send context</button><p class="agent-contact-status" aria-live="polite"></p></form>`;
  return main(`${hero('Contact','Send the complicated version.','A useful first message includes what you are building, what feels unclear, the people involved, and any real timing or technical constraints. Polished briefs are optional.')}<section class="agent-section"><div class="agent-frame agent-contact-grid"><div class="agent-contact-copy" data-agent-reveal><span class="agent-kicker">Start here</span><p class="agent-lead agent-contact-direct">For direct email: <a href="mailto:hinischalsubba@gmail.com">hinischalsubba@gmail.com</a></p><p class="agent-rich-copy">Based in Kathmandu, Nepal. Available for selected remote product work and design collaborations.</p></div><div data-agent-reveal>${form}</div></div></section>`);
};

const cases = {
 'project-yarsha.html': ['Yarsha','Web3 messaging product','A mobile product where messaging, wallet actions, blinks, and transaction review needed to feel like one conversation instead of four separate systems.',[['Role','Product design'],['Year','2024'],['Focus','Messaging + wallet UX'],['Platform','Mobile']],images.yarsha,[['Product problem','Make financial actions understandable inside a social context.','Messaging is conversational and fast. Wallet actions are consequential and need deliberate review. The interface connects both mental models without making every message feel like a banking screen.'],['Structure','Treat the transaction as a stateful object, not a decorative message.','The flow moves from context to deliberate review, intentional signing, and a clearly resolved state inside the conversation.'],['Decisions','Design the uncomfortable states before celebrating the happy path.','Pending, declined, failed, and completed outcomes are first-class states because wallet trust is won or lost there.'],['Handoff','Make the flow understandable to the people building it.','State coverage, hierarchy, responsive assumptions, and transition intent are organized around product decisions rather than disconnected screens.']],[['Conversation first','Wallet actions enter through the conversation.'],['Review before sign','Consequential information gets a deliberate review moment.'],['State completeness','Pending, declined, failed, and complete are explicit.'],['Return to context','Resolved state remains visible in the thread.']],['/project-mokshya','Next: Mokshya.io']],
