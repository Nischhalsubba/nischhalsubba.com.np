 'project-mokshya.html': ['Mokshya.io','Web3 protocol website','A technical protocol website that explains enough for different audiences to trust the product without flattening the technology into generic crypto marketing.',[['Role','Website design'],['Year','2024–25'],['Focus','Hierarchy + trust'],['Audience','Users + developers']],images.mokshya,[['Communication problem','Technical depth is useful only after visitors know why they should care.','The story establishes the product promise quickly, then reveals deeper technical context in a sequence that works for general and developer audiences.'],['Information architecture','Progress from outcome → mechanism → proof → developer path.','Product and technical stories are separated enough to keep first-time visitors oriented while preserving depth.'],['Visual system','Use restraint to make technical material feel more credible.','Hierarchy, pacing, and evidence do the heavy lifting instead of ornamental Web3 effects.'],['Delivery','Design responsive behavior and content structure together.','Reusable section logic and reading measures keep the technical story coherent as content changes.']],[['Outcome first','Give visitors a useful mental model before technical depth.'],['Audience paths','General and developer needs stay distinct but connected.'],['Proof over hype','Claims are supported with product and technical context.'],['Responsive reading','Technical sections retain useful measure on small screens.']],['/project-pihub','Next: piHub']],
 'project-pihub.html': ['piHub','Fintech product','A fintech app spanning investor workflows, applications, credit requests, verification, and profile management where every state needs to earn confidence.',[['Role','App experience'],['Year','2024'],['Focus','Fintech workflows'],['Type','Product UX + UI']],images.pihub,[['Product problem','Financial workflows become difficult when status and next steps are ambiguous.','Several related journeys need to remain distinct while still feeling like one coherent product.'],['Information model','Make status, requirements, and next action visible together.','Users should not need to remember where they are in a process. Status and next action stay adjacent.'],['Interface decisions','Use density where comparison matters and space where decisions matter.','Dashboards can carry more information while application and verification steps need focused pacing.'],['State coverage','A fintech flow is only complete when waiting and failure states are designed.','Pending, incomplete, approved, rejected, and recoverable error states are part of the product experience.']],[['Status clarity','Current state and next action stay visually adjacent.'],['Task-based density','Views change density according to the task.'],['Recovery paths','Errors and incomplete requirements point to a next step.'],['State completeness','Waiting and verification conditions are designed states.']],['/project-hamro-idea','Next: Hamro Idea']],
 'project-hamro-idea.html': ['Hamro Idea','Brand + website','A rebrand and multi-page static website for a Nepal-based software studio, shaped around clearer positioning, service understanding, search structure, and conversion paths.',[['Role','Design + development'],['Year','2025'],['Focus','Positioning + website'],['Delivery','Static front end']],images.hamro,[['Business problem','A service website has to explain what the company does before it can persuade anyone.','The project combined positioning, information architecture, visual design, front-end implementation, and SEO structure.'],['Content system','Organize services around visitor questions, not internal company structure.','Each service gets a clearer role and a path from capability to detail to contact.'],['Design + code','Use implementation as part of the design feedback loop.','Building the front end exposed responsive and content-density decisions early instead of leaving them inside Figma.'],['Delivery','Performance, SEO, and maintainability are part of the surface.','Reusable patterns and semantic structure keep the multi-page experience maintainable.']],[['Positioning first','Service language is written for visitor comprehension.'],['Reusable page logic','Patterns repeat intentionally without making pages identical.'],['Build feedback','Responsive implementation informs design.'],['Search structure','Semantic hierarchy supports scanning and SEO.']],['/projects','Back to all work']],
};
function caseMain(data) {
  const [title,kicker,deck,facts,image,chapters,decisions,next] = data;
  return main(`<header class="agent-case-hero"><div class="agent-frame agent-case-grid"><div class="agent-case-title-wrap"><span class="agent-kicker">${kicker}</span><h1 class="agent-case-title">${title}</h1></div><p class="agent-case-deck">${deck}</p><dl class="agent-case-facts">${facts.map(([t,v]) => `<div><dt>${t}</dt><dd>${v}</dd></div>`).join('')}</dl><figure class="agent-case-cover"><img src="${image}" alt="${title} interface" decoding="async"></figure></div></header><section class="agent-frame agent-case-chapters"><nav class="agent-case-rail" aria-label="Case study chapters">${chapters.map((_,i) => `<a href="#chapter-${i+1}">${String(i+1).padStart(2,'0')}</a>`).join('')}</nav><div class="agent-case-body">${chapters.map(([label,h,p],i) => `<section class="agent-case-chapter" id="chapter-${i+1}" data-agent-reveal><span class="agent-meta">0${i+1} · ${label}</span><h2>${h}</h2><p>${p}</p>${i === 2 ? `<div class="agent-decision-grid">${decisions.map(([a,b]) => `<article class="agent-decision"><strong>${a}</strong><p>${b}</p></article>`).join('')}</div>` : ''}</section>`).join('')}<section class="agent-case-chapter" data-agent-reveal><span class="agent-meta">Continue</span><h2>Keep reading the work.</h2><a class="agent-btn agent-btn--primary" href="${next[0]}">${next[1]}</a></section></div><aside class="agent-case-aside">No invented metrics. Delivered design decisions are separated from effects that would need product analytics or research to validate.</aside></section>`);
}

const coreMain = (rel, html) => /^(index|home|home-v2)\.html$/.test(rel) ? homeMain() : rel === 'projects.html' ? projectsMain() : rel === 'about.html' ? aboutMain() : rel === 'services.html' ? servicesMain() : rel === 'contact.html' ? contactMain(html) : cases[rel] ? caseMain(cases[rel]) : null;
const addBodyClass = (html) => html.replace(/<body([^>]*)>/i, (m,attrs) => /\bclass=["']/.test(attrs) ? `<body${attrs.replace(/class=(["'])([^"']*)\1/i,(x,q,c)=>`class=${q}${c} agent-portfolio${q}`)}>` : `<body${attrs} class="agent-portfolio">`);
const stripShell = (html) => html
 .replace(/\s*<a\b[^>]*class=["'][^"']*skip-link[^"']*["'][^>]*>[\s\S]*?<\/a>/i,'')
 .replace(/\s*<button\b[^>]*class=["'][^"']*mobile-nav-toggle[^"']*["'][^>]*>[\s\S]*?<\/button>/i,'')
 .replace(/\s*<a\b[^>]*class=["'][^"']*mobile-logo[^"']*["'][^>]*>[\s\S]*?<\/a>/i,'')
 .replace(/\s*<div\b[^>]*class=["'][^"']*mobile-nav-overlay[^"']*["'][^>]*>[\s\S]*?<\/div>/i,'')
 .replace(/\s*<button\b[^>]*id=["']theme-toggle["'][^>]*>[\s\S]*?<\/button>/i,'')
 .replace(/\s*<nav\b[^>]*class=["'][^"']*nav-wrapper[^"']*["'][^>]*>[\s\S]*?<\/nav>/i,'')
 .replace(/\s*<div\b[^>]*id=["']agent-progress["'][^>]*><\/div>/i,'');
const replaceFooter = (html) => /<footer\b[^>]*class=["'][^"']*site-footer/i.test(html) ? html.replace(/<footer\b[^>]*class=["'][^"']*site-footer[^"']*["'][^>]*>[\s\S]*?<\/footer>/i,footer()) : html.replace(/<script\b[^>]*src=["']\/script\.js[^>]*><\/script>/i,`${footer()}\n$&`);

const htmlFiles = [];
(function walk(dir){ for(const entry of fs.readdirSync(dir,{withFileTypes:true})){ const full=path.join(dir,entry.name); if(entry.isDirectory()) walk(full); else if(entry.isFile() && entry.name.endsWith('.html')) htmlFiles.push(full); } })(dist);
for (const file of htmlFiles) {
  const rel = path.relative(dist,file).replaceAll(path.sep,'/');
  let html = fs.readFileSync(file,'utf8');
  const replacement = coreMain(rel,html);
  html = addBodyClass(html);
  html = stripShell(html);
  if (replacement) html = html.replace(/<main\b[^>]*>[\s\S]*?<\/main>/i,replacement);
  html = replaceFooter(html);
  html = html.replace(/<body[^>]*>/i,`$&\n${shell(activeKey(rel))}`);
  fs.writeFileSync(file,html,'utf8');
}
const stylePath = path.join(dist,'style.css');
const sourceCss = styleSources.map((file)=>fs.readFileSync(file,'utf8').trim()).join('\n');
let css = fs.existsSync(stylePath) ? fs.readFileSync(stylePath,'utf8') : '';
css = css.replace(/\/\* agent-portfolio:start \*\/[\s\S]*?\/\* agent-portfolio:end \*\//g,'').trimEnd();
fs.writeFileSync(stylePath,`${css}\n\n/* agent-portfolio:start */\n${sourceCss}\n/* agent-portfolio:end */\n`,'utf8');
fs.writeFileSync(path.join(dist,'script.js'),fs.readFileSync(runtimeSource,'utf8'),'utf8');
console.log(`[agent-redesign] Rebuilt ${htmlFiles.length} routes with the from-scratch product-studio system.`);
