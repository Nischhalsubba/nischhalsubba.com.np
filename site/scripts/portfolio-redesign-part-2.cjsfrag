}

const allProjects = [
 ['01','/project-yarsha','Yarsha',['Web3 mobile','Product design','2024'],'Designed messaging, group chat, wallet transfers, blinks, signing review, and bot interactions so financial actions stayed understandable inside a familiar chat flow.',images.yarsha],
 ['02','/project-mokshya','Mokshya.io',['Web3 protocol','Website design','2024–25'],'Reworked a technical protocol story around outcome, mechanism, proof, and developer context, with responsive layouts that keep dense Web3 material readable.',images.mokshya],
 ['03','/project-pihub','piHub',['Fintech','Product UX + UI','2024'],'Structured investor, creditor, admin, application, credit, and verification journeys so status, requirements, and next actions stay visible when decisions matter.',images.pihub],
 ['04','/project-hamro-idea','Hamro Idea',['Software studio','Design + development','2025'],'Repositioned and built a multi-page software studio website, connecting service information architecture, conversion paths, responsive front-end decisions, and SEO structure.',images.hamro],
 ['05','/project-masteriyo','Masteriyo',['WordPress LMS','Design contribution','2021–23'],'Contributed to course authoring, quiz, learning, and admin states inside an existing LMS product and design system as part of a multi-designer product team.',images.masteriyo],
 ['06','/project-orkest','Orkest HQ',['Modular SaaS','UX architecture','2025'],'Structured CRM, sales, inventory, finance, and shared-workspace modules so dense business workflows felt related without collapsing into one generic admin dashboard.',images.orkest],
 ['07','/project-splashnode','Splashnode',['Platform website','Design + front end','2025'],'Designed and coded a website for a content, device, and data-management platform, translating technical capabilities into clearer sections, responsive layouts, and calls to action.',images.splashnode],
 ['08','/project-morajaa','Morajaa',['B2B consulting','Website UX/UI','2025'],'Designed service and sector architecture, premium visual direction, and guided inquiry paths for a consulting website serving business owners, procurement teams, and consultants.',images.morajaa],
];
const projectsMain = () => main(`${hero('Project archive','Eight projects. Different constraints. The same job: make the next decision clearer.','Web3 messaging, fintech workflows, LMS product states, modular SaaS, technical platforms, software services, and B2B consulting. Each project below names the actual scope and design problem instead of hiding behind a generic case-study label.')}<section class="agent-section agent-section--compact agent-project-index-section"><div class="agent-frame"><div class="agent-project-list">${allProjects.map(row).join('')}</div></div></section>`);
const aboutMain = () => main(`${hero('About','Designer close enough to code to know where the bodies are buried.','I’m Nischhal Raj Subba, a product designer in Kathmandu working across product UX, interface design, systems, websites, and implementation handoff.')}<section class="agent-section"><div class="agent-frame agent-about-grid"><div class="agent-about-copy agent-rich-copy" data-agent-reveal><p>My experience spans 6+ years across product teams, agencies, Web3, fintech, SaaS, WordPress products, service businesses, and front-end collaboration. The recurring problem is the same: products become difficult when internal complexity leaks into the interface.</p><p>My work is usually about deciding what deserves to be visible, what needs stronger hierarchy, which states are missing, where users can lose confidence, and how the design behaves when the happy path stops being happy.</p><p>I like Figma, but I do not treat the file as the finish line. Responsive behavior, accessibility, motion, component logic, UI QA, and implementation details all affect whether the product still feels designed after handoff.</p><p>I value direct collaboration. I would rather expose an unclear assumption early than decorate it for another week.</p></div><aside class="agent-about-aside" data-agent-reveal><span class="agent-kicker">Useful context</span><div class="agent-proof-stats agent-proof-stats--stacked"><div class="agent-stat"><strong>6+</strong><span>Years</span></div><div class="agent-stat"><strong>UX ↔ UI</strong><span>Flows, interface, systems, handoff</span></div><div class="agent-stat"><strong>KTM</strong><span>Nepal · remote-friendly</span></div></div></aside></div></section><section class="agent-section agent-process-section" aria-labelledby="agent-process-heading"><div class="agent-frame"><header class="agent-section-head agent-process-head" data-agent-reveal><span class="agent-kicker">How I work</span><h2 class="agent-section-title" id="agent-process-heading">Four passes. Fewer loose ends.</h2></header><div class="agent-process-grid"><article class="agent-process-step" data-agent-reveal><span class="agent-meta">01 · Context</span><div><h3>Product context</h3><p>Start with the goal, users, technical constraints, current friction, evidence, and the decision the product needs to make easier.</p></div></article><article class="agent-process-step" data-agent-reveal><span class="agent-meta">02 · Structure</span><div><h3>Flow + hierarchy</h3><p>Define page structure, screen sequence, content priority, states, permissions, and interaction rules before heavy visual work.</p></div></article><article class="agent-process-step" data-agent-reveal><span class="agent-meta">03 · System</span><div><h3>Interface system</h3><p>Turn the structure into reusable patterns, responsive layouts, polished screens, and a visual language that survives more than one happy path.</p></div></article><article class="agent-process-step" data-agent-reveal><span class="agent-meta">04 · Build</span><div><h3>Review + handoff</h3><p>Prepare states, specs, notes, QA checks, and implementation context, then stay close enough to the build to catch details screenshots cannot.</p></div></article></div></div></section><section class="agent-section agent-section--inverse"><div class="agent-frame agent-manifesto"><blockquote data-agent-reveal>“I’m not interested in making complexity look expensive. I’m interested in making it usable.”</blockquote><aside data-agent-reveal><a class="agent-btn" href="/projects">See selected work</a></aside></div></section>`);
const services = [['01','Product UX','Untangle flows, roles, permissions, states, and decision points before visual polish hides the structural problem.'],['02','Interface design','High-fidelity responsive UI with deliberate hierarchy, useful density, complete states, and product-specific character.'],['03','Design systems','Tokens, components, patterns, documentation, and state coverage that create consistency without making the product a component-library demo.'],['04','Website UX','Product and service websites that explain complicated offers quickly, establish trust, and give visitors an obvious next move.'],['05','UX audit','A structured review of information architecture, friction, hierarchy, accessibility, responsive behavior, interaction patterns, and implementation gaps.'],['06','Design-to-dev','Implementation-aware specs, responsive decisions, front-end collaboration, UI QA, and selective coding where it reduces handoff ambiguity.']];
const servicesMain = () => main(`${hero('Services','Useful when the product has too many moving parts.','Design the product clearly, then choose the support the problem actually needs: a focused audit, one difficult flow, a full interface system, a product website, or ongoing design work.')}<section class="agent-section"><div class="agent-frame agent-service-grid">${services.map(([n,h,p]) => `<article class="agent-service" data-agent-reveal><span class="agent-meta">${n}</span><div><h2>${h}</h2><p>${p}</p></div></article>`).join('')}</div></section><section class="agent-section agent-section--compact"><div class="agent-frame agent-contact-strip"><h2 data-agent-reveal>Have a messy brief?</h2><div class="agent-actions" data-agent-reveal><a class="agent-btn agent-btn--primary" href="/contact">Send the context</a></div></div></section>`);
const addFormClass = (form) => !form ? '' : /\bclass=["']/.test(form) ? form.replace(/class=(["'])([^"']*)\1/i, (m,q,c) => `class=${q}${c} agent-contact-form${q}`) : form.replace(/<form\b/i, '<form class="agent-contact-form"');
const contactMain = (html) => {
  const existing = html.match(/<form\b[\s\S]*?<\/form>/i)?.[0] || '';
  const form = addFormClass(existing) || `<form class="agent-contact-form" action="mailto:hinischhalsubba@gmail.com" method="post" enctype="text/plain"><label>Name<input type="text" name="name" autocomplete="name" required></label><label>Email<input type="email" name="email" autocomplete="email" required></label><label>What are you working on?<textarea name="message" required></textarea></label><button class="agent-btn agent-btn--primary" type="submit">Send context</button><p class="agent-contact-status" aria-live="polite"></p></form>`;
  return main(`${hero('Contact','Send the complicated version.','A useful first message includes what you are building, what feels unclear, the people involved, and any real timing or technical constraints. Polished briefs are optional.')}<section class="agent-section"><div class="agent-frame agent-contact-grid"><div class="agent-contact-copy" data-agent-reveal><span class="agent-kicker">Start here</span><p class="agent-lead agent-contact-direct">For direct email: <a href="mailto:hinischhalsubba@gmail.com">hinischhalsubba@gmail.com</a></p><p class="agent-rich-copy">Based in Kathmandu, Nepal. Available for selected remote product work and design collaborations.</p></div><div data-agent-reveal>${form}</div></div></section>`);
};

const cases = {
 'project-yarsha.html': ['Yarsha','Web3 messaging product','A mobile product where messaging, wallet actions, blinks, and transaction review needed to feel like one conversation instead of four separate systems.',[['Role','Product design'],['Year','2024'],['Focus','Messaging + wallet UX'],['Platform','Mobile']],images.yarsha,[['Product problem','Make financial actions understandable inside a social context.','Messaging is conversational and fast. Wallet actions are consequential and need deliberate review. The interface connects both mental models without making every message feel like a banking screen.'],['Structure','Treat the transaction as a stateful object, not a decorative message.','The flow moves from context to deliberate review, intentional signing, and a clearly resolved state inside the conversation.'],['Decisions','Design the uncomfortable states before celebrating the happy path.','Pending, declined, failed, and completed outcomes are first-class states because wallet trust is won or lost there.'],['Handoff','Make the flow understandable to the people building it.','State coverage, hierarchy, responsive assumptions, and transition intent are organized around product decisions rather than disconnected screens.']],[['Conversation first','Wallet actions enter through the conversation.'],['Review before sign','Consequential information gets a deliberate review moment.'],['State completeness','Pending, declined, failed, and complete are explicit.'],['Return to context','Resolved state remains visible in the thread.']],['/project-mokshya','Next: Mokshya.io']],
