/**
 * @fileoverview src/styles/fragments/agent/portfolio-foundation.cssfrag
 * Purpose: Define composable portfolio foundation CSS rules that are assembled into the production stylesheet rather than served independently.
 * Responsibilities:
 * - Own visual rules only; behavior and state transitions remain in browser runtime modules.
 * - Respect the single-stylesheet production architecture and existing design-system/accessibility audits.
 * - Keep selectors scoped to the intended surface unless this is the canonical global stylesheet.
 * Execution context: Authored stylesheet source assembled or copied into the canonical production CSS.
 * Connected files:
 * - docs/design-dna.json
 * - scripts/compile-single-stylesheet.cjs
 * - scripts/audit-css-architecture.cjs
 * Maintenance: Keep this description synchronized with behavior and dependency changes; document generated code at its generator rather than editing generated output.
 */
/* Agent portfolio 2026: source-of-truth visual layer. All values map to MASTER.md. */
.agent-portfolio {
  --ap-page: #F2EFE7;
  --ap-surface: #FBF8F1;
  --ap-ink: #11110F;
  --ap-ink-soft: #4C4A43;
  --ap-ink-faint: #706C64;
  --ap-line: #C8C1B4;
  --ap-line-strong: #8E887E;
  --ap-signal: #FF4D00;
  --ap-signal-ink: #1A0800;
  --ap-inverse: #11110F;
  --ap-inverse-ink: #F7F2E8;
  --ap-font-display: Arial, "Helvetica Neue", Helvetica, sans-serif;
  --ap-font-body: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --ap-font-editorial: Georgia, "Times New Roman", serif;
  --ap-font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  --ap-gutter: clamp(1.125rem, 3vw, 3.5rem);
  --ap-max: 96rem;
  --ap-read: 45rem;
  --ap-nav-h: 4.5rem;
  --ap-quick: 120ms;
  --ap-standard: 180ms;
  --ap-section: 360ms;
  --ap-slow: 480ms;
  --ap-ease: cubic-bezier(0.2, 0, 0, 1);
  --ap-ease-emphasis: cubic-bezier(0.05, 0.7, 0.1, 1);
  --ap-ease-exit: cubic-bezier(0.3, 0, 1, 1);
  --ap-z-base: 0;
  --ap-z-media: 10;
  --ap-z-nav: 80;
  --ap-z-drawer: 70;
  --ap-z-focus: 100;
  min-width: 0;
  margin: 0;
  background: var(--ap-page);
  color: var(--ap-ink);
  font-family: var(--ap-font-body);
  font-size: 16px;
  line-height: 1.65;
  overflow-x: clip;
  text-rendering: optimizeLegibility;
}

[data-theme='dark'] .agent-portfolio {
  --ap-page: #0C0C0B;
  --ap-surface: #151512;
  --ap-ink: #F3EFE6;
  --ap-ink-soft: #B8B2A7;
  --ap-ink-faint: #8D877E;
  --ap-line: #34322D;
  --ap-line-strong: #5A554D;
  --ap-signal: #FF6B2C;
  --ap-signal-ink: #180A04;
  --ap-inverse: #F3EFE6;
  --ap-inverse-ink: #11110F;
}

.agent-portfolio .skip-link {
  position: fixed;
  inset: 0 auto auto var(--ap-gutter);
  z-index: calc(var(--ap-z-focus) + 20);
  transform: translateY(-130%);
  padding: .75rem 1rem;
  background: var(--ap-signal);
  color: var(--ap-signal-ink);
  font: 700 .82rem/1 var(--ap-font-mono);
  text-transform: uppercase;
  letter-spacing: .08em;
  transition: transform var(--ap-standard) var(--ap-ease);
}

.agent-portfolio .skip-link:focus {
  transform: translateY(.75rem);
}

.agent-portfolio a,
.agent-portfolio button,
.agent-portfolio input,
.agent-portfolio textarea,
.agent-portfolio select {
  font: inherit;
}

.agent-portfolio a {
  color: inherit;
  text-decoration-thickness: .08em;
  text-underline-offset: .2em;
}

.agent-portfolio a:focus-visible,
.agent-portfolio button:focus-visible,
.agent-portfolio input:focus-visible,
.agent-portfolio textarea:focus-visible,
.agent-portfolio select:focus-visible {
  outline: 3px solid var(--ap-signal);
  outline-offset: 3px;
}

.agent-portfolio img,
.agent-portfolio svg,
.agent-portfolio canvas {
  display: block;
  max-width: 100%;
}

.agent-portfolio img {
  height: auto;
}

.agent-portfolio .nav-wrapper {
  position: fixed;
  inset: 0 0 auto 0;
  z-index: var(--ap-z-nav);
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: center;
  gap: 1.25rem;
  min-height: var(--ap-nav-h);
  padding: .75rem var(--ap-gutter);
  border-bottom: 1px solid color-mix(in srgb, var(--ap-line) 76%, transparent);
  background: color-mix(in srgb, var(--ap-page) 92%, transparent);
  color: var(--ap-ink);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.agent-portfolio .agent-brand {
  display: flex;
  align-items: baseline;
  gap: .75rem;
  min-width: 0;
  text-decoration: none;
}

.agent-portfolio .agent-brand strong {
  font: 750 .9rem/1 var(--ap-font-display);
  letter-spacing: -.025em;
}

.agent-portfolio .agent-brand span {
  color: var(--ap-ink-faint);
  font: 500 .68rem/1 var(--ap-font-mono);
  letter-spacing: .08em;
  text-transform: uppercase;
}

.agent-portfolio .nav-pill {
  position: static;
  display: flex;
  align-items: center;
  gap: .25rem;
  width: auto;
  min-height: 3rem;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  transform: none;
}

.agent-portfolio .nav-glider {
  display: none;
}

.agent-portfolio .nav-link {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.75rem;
  padding: 0 .7rem;
  border-radius: 0;
  color: var(--ap-ink-soft);
  font: 650 .73rem/1 var(--ap-font-mono);
  letter-spacing: .06em;
  text-decoration: none;
  text-transform: uppercase;
  transition: color var(--ap-quick) var(--ap-ease), transform var(--ap-quick) var(--ap-ease);
}

.agent-portfolio .nav-link::after {
  content: '';
  position: absolute;
  inset: auto .7rem .4rem .7rem;
  height: 2px;
  background: var(--ap-signal);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform var(--ap-standard) var(--ap-ease);
}

.agent-portfolio .nav-link:hover,
.agent-portfolio .nav-link.active,
.agent-portfolio .nav-link[aria-current='page'] {
  color: var(--ap-ink);
}

.agent-portfolio .nav-link:hover::after,
.agent-portfolio .nav-link.active::after,
.agent-portfolio .nav-link[aria-current='page']::after {
  transform: scaleX(1);
}

.agent-portfolio .nav-link:active {
  transform: translateY(1px);
}

.agent-portfolio .theme-toggle-btn {
  position: static;
  display: inline-grid;
  place-items: center;
  width: 2.75rem;
  height: 2.75rem;
  min-width: 2.75rem;
  min-height: 2.75rem;
  margin: 0;
  border: 1px solid var(--ap-line);
  border-radius: 50%;
  background: transparent;
  color: var(--ap-ink);
  cursor: pointer;
  box-shadow: none;
  transition: border-color var(--ap-quick) var(--ap-ease), background-color var(--ap-quick) var(--ap-ease), transform var(--ap-quick) var(--ap-ease);
}

.agent-portfolio .theme-toggle-btn::before {
  content: '';
  width: .75rem;
  height: .75rem;
  border-radius: 50%;
  border: 1px solid currentColor;
  background: linear-gradient(90deg, currentColor 50%, transparent 50%);
}

.agent-portfolio .theme-toggle-btn:hover {
  border-color: var(--ap-ink);
  background: color-mix(in srgb, var(--ap-ink) 6%, transparent);
}

.agent-portfolio .mobile-nav-toggle,
.agent-portfolio .mobile-logo,
.agent-portfolio .mobile-nav-overlay {
  display: none;
}

.agent-portfolio .agent-main,
.agent-portfolio .container,
.agent-portfolio main {
  min-width: 0;
}

.agent-portfolio .agent-main {
  padding-top: var(--ap-nav-h);
}

.agent-portfolio .agent-frame {
  width: min(100%, var(--ap-max));
  margin-inline: auto;
  padding-inline: var(--ap-gutter);
}

.agent-portfolio .agent-meta {
  margin: 0;
  color: var(--ap-ink-faint);
  font: 600 .74rem/1.35 var(--ap-font-mono);
  letter-spacing: .08em;
  text-transform: uppercase;
}

.agent-portfolio .agent-kicker {
  display: inline-flex;
  align-items: center;
  gap: .55rem;
  color: var(--ap-ink-soft);
  font: 600 .76rem/1.3 var(--ap-font-mono);
  letter-spacing: .08em;
  text-transform: uppercase;
}

.agent-portfolio .agent-kicker::before {
  content: '';
  width: .6rem;
  height: .6rem;
  background: var(--ap-signal);
}

.agent-portfolio .agent-display {
  margin: 0;
  font-family: var(--ap-font-display);
  font-weight: 750;
  letter-spacing: -.075em;
  line-height: .86;
  text-wrap: balance;
}

.agent-portfolio .agent-serif {
  font-family: var(--ap-font-editorial);
  font-style: italic;
  font-weight: 400;
  letter-spacing: -.045em;
}

.agent-portfolio .agent-lead {
  max-width: 43rem;
  margin: 0;
  color: var(--ap-ink-soft);
  font-size: clamp(1.08rem, 1.6vw, 1.5rem);
  line-height: 1.48;
  text-wrap: pretty;
}

.agent-portfolio .agent-hero {
  position: relative;
  min-height: min(58rem, 100dvh);
  display: grid;
  align-items: end;
  border-bottom: 1px solid var(--ap-line);
  overflow: clip;
}

.agent-portfolio .agent-hero-grid {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: 1rem;
  align-items: end;
  padding-top: clamp(8rem, 16vh, 11rem);
  padding-bottom: clamp(3rem, 7vh, 5.5rem);
}

.agent-portfolio .agent-hero-copy {
  grid-column: 1 / span 8;
  display: grid;
  gap: 2rem;
}

.agent-portfolio .agent-hero-title {
  font-size: clamp(4.35rem, 9.4vw, 10rem);
  max-width: 9.3ch;
}

.agent-portfolio .agent-hero-title .agent-serif {
  color: var(--ap-signal);
}

.agent-portfolio .agent-hero-support {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 1.5rem 2.5rem;
  align-items: end;
  max-width: 52rem;
}

.agent-portfolio .agent-actions {
  display: flex;
  flex-wrap: wrap;
  gap: .75rem;
}

.agent-portfolio .agent-btn {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.2rem;
  min-height: 3rem;
  padding: .72rem 1rem;
  border: 1px solid var(--ap-ink);
  border-radius: 0;
  background: transparent;
  color: var(--ap-ink);
  font: 700 .76rem/1 var(--ap-font-mono);
  letter-spacing: .06em;
  text-decoration: none;
  text-transform: uppercase;
  cursor: pointer;
  transition: transform var(--ap-quick) var(--ap-ease), background-color var(--ap-standard) var(--ap-ease), color var(--ap-standard) var(--ap-ease), border-color var(--ap-standard) var(--ap-ease);
}

.agent-portfolio .agent-btn::after {
  content: '↗';
  font-family: var(--ap-font-body);
  font-size: 1rem;
}

.agent-portfolio .agent-btn--primary {
  background: var(--ap-inverse);
  color: var(--ap-inverse-ink);
}

.agent-portfolio .agent-btn:hover {
  transform: translateY(-1px);
  background: var(--ap-signal);
  border-color: var(--ap-signal);
  color: var(--ap-signal-ink);
}

.agent-portfolio .agent-btn:active {
  transform: translateY(1px);
}

.agent-portfolio .agent-hero-side {
  grid-column: 9 / -1;
  display: grid;
  gap: 1.2rem;
  align-self: stretch;
  min-height: 27rem;
  padding-top: 2.4rem;
}

.agent-portfolio .agent-system-figure {
  position: relative;
  min-height: 22rem;
  border-top: 1px solid var(--ap-line-strong);
  border-bottom: 1px solid var(--ap-line);
  overflow: clip;
  isolation: isolate;
}

.agent-portfolio .agent-system-figure::before,
.agent-portfolio .agent-system-figure::after {
  content: '';
  position: absolute;
  z-index: -1;
  pointer-events: none;
}

.agent-portfolio .agent-system-figure::before {
  inset: 0;
  background-image:
    linear-gradient(to right, color-mix(in srgb, var(--ap-line) 54%, transparent) 1px, transparent 1px),
    linear-gradient(to bottom, color-mix(in srgb, var(--ap-line) 54%, transparent) 1px, transparent 1px);
  background-size: 2.25rem 2.25rem;
  mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 85%, transparent);
}

.agent-portfolio .agent-system-figure::after {
  width: 9rem;
  height: 9rem;
  right: 12%;
  top: 22%;
  border: 1px solid var(--ap-signal);
  border-radius: 50%;
  box-shadow: 4.5rem 5.5rem 0 -4.2rem var(--ap-signal), -4rem 7rem 0 -4.1rem var(--ap-ink);
  opacity: .74;
}

.agent-portfolio .agent-system-label {
  position: absolute;
  inset: auto auto .9rem .9rem;
  z-index: 2;
  max-width: 15rem;
  margin: 0;
  color: var(--ap-ink-soft);
  font: 600 .69rem/1.45 var(--ap-font-mono);
  letter-spacing: .04em;
  text-transform: uppercase;
}

.agent-portfolio .agent-three-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: .92;
  pointer-events: none;
}

.agent-portfolio .agent-hero-foot {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  align-items: center;
  color: var(--ap-ink-faint);
  font: 600 .68rem/1.3 var(--ap-font-mono);
  letter-spacing: .07em;
  text-transform: uppercase;
}

.agent-portfolio .agent-section {
  padding-block: clamp(5rem, 9vw, 9.5rem);
  border-bottom: 1px solid var(--ap-line);
}

.agent-portfolio .agent-section--compact {
  padding-block: clamp(3.75rem, 6vw, 6.5rem);
}

.agent-portfolio .agent-section--inverse {
  background: var(--ap-inverse);
  color: var(--ap-inverse-ink);
  border-color: color-mix(in srgb, var(--ap-inverse-ink) 24%, transparent);
}

.agent-portfolio .agent-section-head {
  display: grid;
  grid-template-columns: 2fr 5fr 3fr 2fr;
  gap: 1rem;
  align-items: start;
  margin-bottom: clamp(3rem, 6vw, 6rem);
}

.agent-portfolio .agent-section-head .agent-kicker {
  grid-column: 1 / span 2;
}

.agent-portfolio .agent-section-title {
  grid-column: 3 / -1;
  margin: 0;
  font: 700 clamp(2.5rem, 5.5vw, 6rem)/.92 var(--ap-font-display);
  letter-spacing: -.065em;
  text-wrap: balance;
}

.agent-portfolio .agent-project-list {
  display: grid;
  border-top: 1px solid var(--ap-line-strong);
}

.agent-portfolio .agent-project-row {
  display: grid;
  grid-template-columns: .7fr 3.2fr 2fr 5.2fr .7fr;
  gap: 1rem;
  align-items: center;
  min-height: clamp(14rem, 25vw, 25rem);
  padding-block: clamp(1.5rem, 3vw, 2.5rem);
  border-bottom: 1px solid var(--ap-line);
  color: inherit;
  text-decoration: none;
}

.agent-portfolio .agent-project-index {
  align-self: start;
  color: var(--ap-signal);
  font: 700 .74rem/1 var(--ap-font-mono);
}

.agent-portfolio .agent-project-copy {
  align-self: start;
  display: grid;
  gap: .85rem;
  padding-top: .1rem;
}

.agent-portfolio .agent-project-copy h3 {
  margin: 0;
  font: 740 clamp(2.25rem, 5vw, 5.8rem)/.88 var(--ap-font-display);
  letter-spacing: -.07em;
}

.agent-portfolio .agent-project-copy p {
  max-width: 32rem;
