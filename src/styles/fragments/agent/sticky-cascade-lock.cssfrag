/**
 * @fileoverview src/styles/fragments/agent/sticky-cascade-lock.cssfrag
 * Purpose: Composable stylesheet fragment for sticky cascade lock rules assembled into the production stylesheet.
 * Responsibilities:
 * - Own the behavior/content implied by this file's single responsibility.
 * - Keep public routes, build contracts, and imported module boundaries stable unless the connected owners are updated together.
 * Execution context: Stylesheet source assembled or copied into production CSS.
 * Connected files:
 * - docs/repository/file-catalog.md
 * - scripts/agent-polish.cjs
 * - scripts/repository/apply-deep-organization.cjs
 * - scripts/repository/fix-deep-style-contracts.cjs
 * Maintenance: Update this header when responsibility or dependencies change; generated/vendor files are documented at their source instead.
 */
/* Final cascade lock for legacy production rules that still use !important on site chrome. */
body.agent-portfolio,
body.agent-portfolio *,
body.agent-portfolio *::before,
body.agent-portfolio *::after {
  box-sizing: border-box;
}

body.agent-portfolio .nav-wrapper {
  position: fixed !important;
  top: 0 !important;
  z-index: var(--ap-z-nav) !important;
}

body.agent-portfolio #agent-progress {
  position: fixed !important;
  top: 0 !important;
  right: 0 !important;
  bottom: auto !important;
  left: 0 !important;
  z-index: calc(var(--ap-z-nav) + 10) !important;
}

body.agent-portfolio .agent-mobile-theme-toggle {
  display: none;
}

body.agent-portfolio .agent-project-row,
body.agent-portfolio .agent-project-copy,
body.agent-portfolio .agent-project-meta,
body.agent-portfolio .agent-project-media,
body.agent-portfolio .agent-case-cover,
body.agent-portfolio .agent-index-item {
  min-width: 0;
  max-width: 100%;
}

body.agent-portfolio .agent-project-media,
body.agent-portfolio .agent-case-cover {
  width: 100%;
  margin: 0;
}

body.agent-portfolio .agent-project-media img,
body.agent-portfolio .agent-case-cover img {
  display: block;
  width: 100%;
  max-width: 100%;
}

@media (max-width: 1023px) {
  body.agent-portfolio .nav-wrapper {
    display: grid !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    max-width: none !important;
    padding-right: calc(var(--ap-gutter) + 4.25rem) !important;
    transform: none !important;
  }

  body.agent-portfolio .theme-toggle-btn {
    display: none !important;
  }

  body.agent-portfolio .mobile-nav-toggle {
    position: fixed !important;
    top: calc(env(safe-area-inset-top) + .6rem) !important;
    right: var(--ap-gutter) !important;
    left: auto !important;
    display: grid !important;
    width: 2.75rem !important;
    height: 2.75rem !important;
    min-width: 2.75rem !important;
    min-height: 2.75rem !important;
    padding: 0 !important;
    transform: none !important;
    z-index: calc(var(--ap-z-nav) + 4) !important;
  }

  body.agent-portfolio .mobile-nav-overlay {
    align-content: end;
    align-items: stretch;
  }

  body.agent-portfolio .agent-mobile-theme-toggle {
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: 3.5rem;
    margin: 1rem 0 0;
    padding: .85rem 0;
    border: 0;
    border-top: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    border-bottom: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: 650 .76rem/1 var(--ap-font-mono);
    letter-spacing: .06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  body.agent-portfolio .agent-mobile-theme-toggle span:last-child {
    color: color-mix(in srgb, currentColor 68%, transparent);
    font-size: .68rem;
  }
}

@media (max-width: 767px) {
  body.agent-portfolio .agent-project-row {
    grid-template-columns: 2.2rem minmax(0, 1fr) !important;
    width: 100%;
  }

  body.agent-portfolio .agent-index-item {
    grid-template-columns: 2rem minmax(0, 1fr) !important;
    width: 100%;
  }

  body.agent-portfolio .agent-btn,
  body.agent-portfolio .agent-contact-form .nrs-contact-form-actions .agent-btn,
  body.agent-portfolio .agent-actions .agent-btn {
    min-height: 48px;
  }
}
