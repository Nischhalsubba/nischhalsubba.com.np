/* Existing production runtime drives these states. Keep the visual layer compatible with it. */
.agent-portfolio .theme-toggle-btn svg {
  display: none;
}

.agent-portfolio.menu-open .mobile-nav-overlay,
.agent-portfolio .mobile-nav-overlay[aria-hidden='false'] {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateY(0);
  transition: opacity var(--ap-section) var(--ap-ease), transform var(--ap-section) var(--ap-ease), visibility 0s step-start;
}

.agent-portfolio .mobile-nav-overlay[hidden] {
  display: none;
}

.agent-portfolio .agent-breadcrumb-wrap {
  padding-top: 1rem;
}

.agent-portfolio .agent-breadcrumbs {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: .45rem;
  margin: 0;
  color: var(--ap-ink-faint);
  font: 600 .7rem/1.35 var(--ap-font-mono);
  letter-spacing: .06em;
  text-transform: uppercase;
}

.agent-portfolio .agent-breadcrumbs a {
  min-height: 2.75rem;
  display: inline-flex;
  align-items: center;
  color: var(--ap-ink-soft);
  text-decoration: none;
}

.agent-portfolio .agent-breadcrumbs a:hover {
  color: var(--ap-signal);
}

.agent-portfolio .agent-embed-note {
  margin-block: 1.5rem;
}
