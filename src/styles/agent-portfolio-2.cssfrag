  margin: 0;
  color: var(--ap-ink-soft);
  font-size: clamp(1rem, 1.3vw, 1.2rem);
  line-height: 1.5;
}

.agent-portfolio .agent-project-meta {
  align-self: start;
  display: grid;
  gap: .5rem;
  padding-top: .3rem;
  color: var(--ap-ink-faint);
  font: 600 .69rem/1.4 var(--ap-font-mono);
  letter-spacing: .04em;
  text-transform: uppercase;
}

.agent-portfolio .agent-project-media {
  position: relative;
  aspect-ratio: 16 / 10;
  min-width: 0;
  overflow: hidden;
  background: var(--ap-surface);
  border: 1px solid var(--ap-line);
}

.agent-portfolio .agent-project-media::after {
  content: '';
  position: absolute;
  inset: 0;
  border: 1px solid color-mix(in srgb, var(--ap-ink) 10%, transparent);
  pointer-events: none;
}

.agent-portfolio .agent-project-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--ap-slow) var(--ap-ease-emphasis), filter var(--ap-slow) var(--ap-ease);
}

.agent-portfolio .agent-project-arrow {
  display: grid;
  place-items: center;
  width: 2.8rem;
  height: 2.8rem;
  justify-self: end;
  border: 1px solid var(--ap-line);
  border-radius: 50%;
  font-size: 1.1rem;
  transition: transform var(--ap-standard) var(--ap-ease), background-color var(--ap-standard) var(--ap-ease), color var(--ap-standard) var(--ap-ease), border-color var(--ap-standard) var(--ap-ease);
}

.agent-portfolio .agent-project-row:hover .agent-project-media img {
  transform: scale(1.018);
}

.agent-portfolio .agent-project-row:hover .agent-project-arrow {
  transform: translate(2px, -2px);
  background: var(--ap-signal);
  border-color: var(--ap-signal);
  color: var(--ap-signal-ink);
}

.agent-portfolio .agent-capabilities {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: 1rem;
  border-top: 1px solid currentColor;
}

.agent-portfolio .agent-capability {
  grid-column: span 3;
  display: grid;
  align-content: space-between;
  gap: 3rem;
  min-height: 18rem;
  padding: 1.2rem 0;
  border-bottom: 1px solid color-mix(in srgb, currentColor 28%, transparent);
}

.agent-portfolio .agent-capability:nth-child(2),
.agent-portfolio .agent-capability:nth-child(4) {
  transform: translateY(2rem);
}

.agent-portfolio .agent-capability h3 {
  margin: 0;
  font: 700 clamp(1.6rem, 2.4vw, 2.6rem)/1 var(--ap-font-display);
  letter-spacing: -.045em;
}

.agent-portfolio .agent-capability p {
  margin: 0;
  color: color-mix(in srgb, currentColor 70%, transparent);
  font-size: .98rem;
  line-height: 1.6;
}

.agent-portfolio .agent-proof-grid {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: 1rem;
  align-items: end;
}

.agent-portfolio .agent-proof-big {
  grid-column: 1 / span 7;
  margin: 0;
  font: 720 clamp(3.5rem, 8vw, 8.5rem)/.86 var(--ap-font-display);
  letter-spacing: -.075em;
}

.agent-portfolio .agent-proof-copy {
  grid-column: 9 / -1;
  display: grid;
  gap: 1.5rem;
}

.agent-portfolio .agent-proof-copy p {
  margin: 0;
  color: var(--ap-ink-soft);
  font-size: 1.05rem;
  line-height: 1.6;
}

.agent-portfolio .agent-proof-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: clamp(3rem, 6vw, 6rem);
  border-top: 1px solid var(--ap-line-strong);
}

.agent-portfolio .agent-stat {
  padding: 1.25rem 1.25rem 0 0;
  border-right: 1px solid var(--ap-line);
}

.agent-portfolio .agent-stat:last-child {
  border-right: 0;
}

.agent-portfolio .agent-stat strong {
  display: block;
  margin-bottom: .5rem;
  font: 720 clamp(2rem, 4vw, 4.7rem)/1 var(--ap-font-display);
  letter-spacing: -.06em;
}

.agent-portfolio .agent-stat span {
  color: var(--ap-ink-faint);
  font: 600 .7rem/1.45 var(--ap-font-mono);
  letter-spacing: .05em;
  text-transform: uppercase;
}

.agent-portfolio .agent-manifesto {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: 1rem;
}

.agent-portfolio .agent-manifesto blockquote {
  grid-column: 2 / span 8;
  margin: 0;
  font: 400 clamp(2.7rem, 6vw, 6.8rem)/.95 var(--ap-font-editorial);
  font-style: italic;
  letter-spacing: -.055em;
}

.agent-portfolio .agent-manifesto aside {
  grid-column: 10 / -1;
  align-self: end;
  color: var(--ap-ink-soft);
}

.agent-portfolio .agent-contact-strip {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: 1rem;
  align-items: end;
}

.agent-portfolio .agent-contact-strip h2 {
  grid-column: 1 / span 8;
  margin: 0;
  font: 740 clamp(3.8rem, 9vw, 9rem)/.86 var(--ap-font-display);
  letter-spacing: -.075em;
}

.agent-portfolio .agent-contact-strip .agent-actions {
  grid-column: 9 / -1;
  justify-content: flex-end;
}

.agent-portfolio .agent-page-hero {
  padding-top: clamp(8rem, 14vw, 13rem);
  padding-bottom: clamp(4rem, 8vw, 8rem);
  border-bottom: 1px solid var(--ap-line);
}

.agent-portfolio .agent-page-hero-grid {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: 1rem;
  align-items: end;
}

.agent-portfolio .agent-page-hero h1 {
  grid-column: 1 / span 9;
  margin: 1.5rem 0 0;
  font: 740 clamp(4rem, 9vw, 9rem)/.87 var(--ap-font-display);
  letter-spacing: -.075em;
}

.agent-portfolio .agent-page-intro {
  grid-column: 9 / -1;
  margin: 0 0 .6rem;
  color: var(--ap-ink-soft);
  font-size: clamp(1.02rem, 1.4vw, 1.25rem);
  line-height: 1.55;
}

.agent-portfolio .agent-index-list {
  display: grid;
  border-top: 1px solid var(--ap-line-strong);
}

.agent-portfolio .agent-index-item {
  display: grid;
  grid-template-columns: .7fr 3fr 2fr 5.3fr 1fr;
  gap: 1rem;
  align-items: center;
  padding-block: 1.3rem;
  border-bottom: 1px solid var(--ap-line);
  text-decoration: none;
}

.agent-portfolio .agent-index-item h2,
.agent-portfolio .agent-index-item h3 {
  margin: 0;
  font: 700 clamp(1.7rem, 3.4vw, 3.8rem)/.95 var(--ap-font-display);
  letter-spacing: -.055em;
}

.agent-portfolio .agent-index-item p {
  margin: 0;
  color: var(--ap-ink-soft);
}

.agent-portfolio .agent-about-grid,
.agent-portfolio .agent-service-grid,
.agent-portfolio .agent-contact-grid,
.agent-portfolio .agent-case-grid {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: 1rem;
}

.agent-portfolio .agent-about-copy {
  grid-column: 2 / span 7;
}

.agent-portfolio .agent-about-aside {
  grid-column: 10 / -1;
  align-self: start;
  position: sticky;
  top: calc(var(--ap-nav-h) + 2rem);
}

.agent-portfolio .agent-rich-copy {
  max-width: var(--ap-read);
  color: var(--ap-ink-soft);
}

.agent-portfolio .agent-rich-copy p {
  margin: 0 0 1.35em;
  font-size: clamp(1.05rem, 1.4vw, 1.2rem);
  line-height: 1.72;
}

.agent-portfolio .agent-rich-copy h2,
.agent-portfolio .agent-rich-copy h3 {
  color: var(--ap-ink);
}

.agent-portfolio .agent-service-grid {
  border-top: 1px solid var(--ap-line-strong);
}

.agent-portfolio .agent-service {
  grid-column: span 4;
  min-height: 20rem;
  display: grid;
  align-content: space-between;
  gap: 4rem;
  padding: 1.3rem 1.5rem 1.5rem 0;
  border-right: 1px solid var(--ap-line);
  border-bottom: 1px solid var(--ap-line);
}

.agent-portfolio .agent-service:nth-child(3n) {
  border-right: 0;
}

.agent-portfolio .agent-service h2,
.agent-portfolio .agent-service h3 {
  margin: 0;
  font: 700 clamp(1.8rem, 3vw, 3.2rem)/.95 var(--ap-font-display);
  letter-spacing: -.055em;
}

.agent-portfolio .agent-contact-copy {
  grid-column: 1 / span 5;
}

.agent-portfolio .agent-contact-form {
  grid-column: 7 / -1;
  display: grid;
  gap: 1rem;
}

.agent-portfolio .agent-contact-form label {
  display: grid;
  gap: .5rem;
  color: var(--ap-ink-soft);
  font: 600 .72rem/1.3 var(--ap-font-mono);
  letter-spacing: .06em;
  text-transform: uppercase;
}

.agent-portfolio .agent-contact-form input,
.agent-portfolio .agent-contact-form textarea,
.agent-portfolio .agent-contact-form select {
  width: 100%;
  min-height: 3.25rem;
  padding: .75rem 0;
  border: 0;
  border-bottom: 1px solid var(--ap-line-strong);
  border-radius: 0;
  background: transparent;
  color: var(--ap-ink);
  font: 500 1rem/1.45 var(--ap-font-body);
  transition: border-color var(--ap-standard) var(--ap-ease);
}

.agent-portfolio .agent-contact-form textarea {
  min-height: 8rem;
  resize: vertical;
}

.agent-portfolio .agent-contact-form input:focus,
.agent-portfolio .agent-contact-form textarea:focus,
.agent-portfolio .agent-contact-form select:focus {
  border-color: var(--ap-signal);
}

.agent-portfolio .agent-contact-status {
  min-height: 1.5rem;
  color: var(--ap-ink-soft);
  font-size: .9rem;
}

.agent-portfolio .agent-case-hero {
  padding-top: clamp(8rem, 13vw, 12rem);
  padding-bottom: clamp(3.5rem, 6vw, 6rem);
  border-bottom: 1px solid var(--ap-line);
}

.agent-portfolio .agent-case-title {
  grid-column: 1 / span 9;
  margin: 1.5rem 0 2rem;
  font: 740 clamp(4rem, 10vw, 10rem)/.84 var(--ap-font-display);
  letter-spacing: -.08em;
}

.agent-portfolio .agent-case-deck {
  grid-column: 1 / span 7;
  margin: 0;
  color: var(--ap-ink-soft);
  font-size: clamp(1.15rem, 1.8vw, 1.55rem);
  line-height: 1.48;
}

.agent-portfolio .agent-case-facts {
  grid-column: 9 / -1;
  align-self: end;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
  margin: 0;
}

.agent-portfolio .agent-case-facts div {
  padding-top: .75rem;
  border-top: 1px solid var(--ap-line);
}

.agent-portfolio .agent-case-facts dt {
  color: var(--ap-ink-faint);
  font: 600 .67rem/1.3 var(--ap-font-mono);
  letter-spacing: .06em;
  text-transform: uppercase;
}

.agent-portfolio .agent-case-facts dd {
  margin: .3rem 0 0;
  font-weight: 650;
}

.agent-portfolio .agent-case-cover {
  margin-top: 3rem;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border: 1px solid var(--ap-line);
  background: var(--ap-surface);
}

.agent-portfolio .agent-case-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.agent-portfolio .agent-case-chapters {
  display: grid;
  grid-template-columns: minmax(10rem, 2fr) minmax(0, 8fr) minmax(0, 2fr);
  gap: 1rem;
  padding-block: clamp(4rem, 8vw, 8rem);
}

.agent-portfolio .agent-case-rail {
  position: sticky;
  top: calc(var(--ap-nav-h) + 2rem);
  align-self: start;
  display: grid;
  gap: .5rem;
  color: var(--ap-ink-faint);
  font: 600 .68rem/1.4 var(--ap-font-mono);
  text-transform: uppercase;
  letter-spacing: .05em;
}

.agent-portfolio .agent-case-body {
  display: grid;
  gap: clamp(4rem, 8vw, 8rem);
}

.agent-portfolio .agent-case-chapter {
  scroll-margin-top: calc(var(--ap-nav-h) + 2rem);
}

.agent-portfolio .agent-case-chapter > .agent-meta {
  margin-bottom: 1rem;
}

.agent-portfolio .agent-case-chapter h2 {
  max-width: 11ch;
  margin: 0 0 1.6rem;
  font: 720 clamp(2.4rem, 5vw, 5.2rem)/.92 var(--ap-font-display);
  letter-spacing: -.06em;
}

.agent-portfolio .agent-case-chapter p,
.agent-portfolio .agent-case-chapter li {
  max-width: var(--ap-read);
  color: var(--ap-ink-soft);
  font-size: clamp(1rem, 1.25vw, 1.15rem);
  line-height: 1.72;
}

.agent-portfolio .agent-case-chapter ul {
  display: grid;
  gap: .65rem;
  padding-left: 1.2rem;
}

.agent-portfolio .agent-decision-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  margin-top: 2rem;
  background: var(--ap-line);
  border: 1px solid var(--ap-line);
}

.agent-portfolio .agent-decision {
  min-height: 13rem;
  padding: 1.3rem;
  background: var(--ap-page);
}

.agent-portfolio .agent-decision strong {
  display: block;
  margin-bottom: 2.5rem;
  font: 700 1.4rem/1.05 var(--ap-font-display);
  letter-spacing: -.035em;
}

.agent-portfolio .agent-case-aside {
  align-self: start;
  color: var(--ap-ink-faint);
  font: 500 .76rem/1.55 var(--ap-font-mono);
}

.agent-portfolio .site-footer {
  margin: 0;
  padding: clamp(4rem, 8vw, 8rem) var(--ap-gutter) 2rem;
  border: 0;
  background: var(--ap-inverse);
  color: var(--ap-inverse-ink);
}

.agent-portfolio .agent-footer-grid {
  width: min(100%, var(--ap-max));
  margin-inline: auto;
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: 1rem;
}

.agent-portfolio .agent-footer-cta {
  grid-column: 1 / span 9;
  margin: 0;
  font: 740 clamp(3.8rem, 9vw, 9.5rem)/.85 var(--ap-font-display);
  letter-spacing: -.08em;
}

.agent-portfolio .agent-footer-cta a {
  color: inherit;
  text-decoration: none;
}

.agent-portfolio .agent-footer-cta a:hover {
  color: var(--ap-signal);
}

.agent-portfolio .agent-footer-links {
  grid-column: 10 / -1;
  display: grid;
  align-content: end;
  gap: .55rem;
}

.agent-portfolio .agent-footer-links a {
  min-height: 2rem;
  color: color-mix(in srgb, currentColor 78%, transparent);
  font: 600 .72rem/1.4 var(--ap-font-mono);
  letter-spacing: .04em;
  text-decoration: none;
  text-transform: uppercase;
}

.agent-portfolio .agent-footer-bottom {
  grid-column: 1 / -1;
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 5rem;
  padding-top: 1rem;
  border-top: 1px solid color-mix(in srgb, currentColor 22%, transparent);
  color: color-mix(in srgb, currentColor 62%, transparent);
  font: 500 .68rem/1.4 var(--ap-font-mono);
  text-transform: uppercase;
  letter-spacing: .05em;
}

/* Existing inner routes inherit the same visual language even when their authored body remains intact. */
