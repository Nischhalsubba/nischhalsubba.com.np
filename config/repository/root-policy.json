{
  "description": "Repository-root policy. Keeps only ecosystem entry/configuration files at root and prevents production source files from drifting back out of organized folders.",
  "connectedFiles": [
    "scripts/repository/audit-repository-structure.cjs",
    "scripts/repository/source-layout.cjs",
    "scripts/repository/generate-file-catalog.cjs",
    "docs/repository/file-map.md",
    "docs/repository/file-catalog.md"
  ],
  "allowedRootFiles": [
    ".editorconfig",
    ".gitignore",
    "AGENTS.md",
    "README.md",
    "package-lock.json",
    "package.json",
    "tsconfig.json",
    "vercel.json",
    "vite.config.ts",
    "wrangler.jsonc"
  ],
  "forbiddenTrackedPrefixes": [
    "wordpress/"
  ],
  "requiredDocumentation": [
    "config/repository/code-documentation-policy.json",
    "docs/repository/file-catalog.md",
    "docs/repository/file-map.md",
    "scripts/repository/README.md",
    "src/README.md",
    "src/compat/README.md",
    "src/discovery/README.md",
    "src/pages/README.md",
    "src/runtime/README.md",
    "src/scripts/README.md",
    "src/scripts/entrypoints/README.md",
    "src/scripts/shared/README.md",
    "src/styles/README.md",
    "src/styles/fragments/README.md",
    "src/styles/systems/README.md"
  ]
}
