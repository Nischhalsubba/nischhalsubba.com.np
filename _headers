/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://www.googletagmanager.com https://plausible.io https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://challenges.cloudflare.com https://formsubmit.co https://www.google-analytics.com https://plausible.io https://cloudflareinsights.com https://static.cloudflareinsights.com; frame-src https://challenges.cloudflare.com https://www.figma.com https://figma.com https://embed.figma.com; form-action 'self' https://formsubmit.co; upgrade-insecure-requests

# Authored project media and generated social previews can be cached at the edge.
# HTML, /style.css and /script.js intentionally use Cloudflare's default ETag
# revalidation semantics so deploys do not serve stale application shells.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/resume.pdf
  Content-Type: application/pdf
  Content-Disposition: attachment; filename="Nischhal-Raj-Subba-Resume.pdf"
  X-Robots-Tag: noindex

# Crawl-control files should refresh quickly after deploys.
/sitemap.xml
  Cache-Control: public, max-age=300, must-revalidate

/robots.txt
  Cache-Control: public, max-age=300, must-revalidate

# AI discovery resources remain crawlable, but are not intended as traditional
# search-result documents. X-Robots-Tag is the correct non-HTML noindex control.
/llms.txt
  Cache-Control: public, max-age=300, must-revalidate
  X-Robots-Tag: noindex

/llms-full.txt
  Cache-Control: public, max-age=300, must-revalidate
  X-Robots-Tag: noindex

/ai-profile.json
  Cache-Control: public, max-age=300, must-revalidate
  X-Robots-Tag: noindex

/humans.txt
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: noindex

/site.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate
