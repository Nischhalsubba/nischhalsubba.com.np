{
  "name": "nischhal-raj-subba-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Production portfolio for Nischhal Raj Subba, a Nepal-based product designer focused on Web3, SaaS, fintech, UX systems, and developer-ready design handoff.",
  "author": "Nischhal Raj Subba",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/preflight-build-scripts.cjs && node scripts/generate-seo-discovery.cjs",
    "generate": "node scripts/generate-source.cjs",
    "sync:seo-discovery": "node scripts/generate-seo-discovery.cjs",
    "build": "node scripts/build-dist.cjs && node scripts/write-build-metadata.cjs",
    "build:dist": "npm run build",
    "preview": "vite preview",
    "preview:static": "npx http-server -p 4173 dist",
    "lint": "node scripts/lint-project.cjs",
    "check:links": "node scripts/check-links.js",
    "audit:build": "node scripts/audit-build.cjs",
    "audit:css-architecture": "node scripts/audit-css-architecture.cjs",
    "audit:design-system": "node scripts/audit-design-system-coverage.cjs",
    "audit:provenance": "node scripts/audit-build-provenance.cjs",
    "audit:shared-shell": "node scripts/audit-shared-shell.cjs",
    "audit:structure": "node scripts/audit-content-structure.cjs",
    "audit:seo": "node scripts/audit-final-seo.cjs",
    "audit:seo-contract": "node scripts/audit-seo-contract.cjs",
    "audit:seo-discovery": "node scripts/audit-seo-discovery.cjs",
    "audit:voice": "node scripts/audit-content-voice.cjs",
    "audit:accessibility-tokens": "node scripts/audit-accessibility-tokens.cjs",
    "test:build-determinism": "node scripts/test-build-determinism.cjs",
    "test:smoke": "node scripts/smoke-test-dist.mjs",
    "test:routes:live": "node scripts/verify-live-routes.mjs",
    "validate": "npm run build && npm run lint && npm run test:build-determinism && npm run audit:seo && npm run audit:seo-contract && npm run audit:seo-discovery && npm run audit:structure && npm run check:links && npm run audit:build && npm run audit:shared-shell && npm run audit:css-architecture && npm run audit:design-system && npm run audit:voice && npm run audit:accessibility-tokens && npm run audit:provenance && npm run test:smoke"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
