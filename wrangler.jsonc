{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-website-2026",
  "main": "./src/worker.js",
  "compatibility_date": "2026-02-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "hinischalsubba@gmail.com"
    }
  ]
}
